# ============================================================
# AI VIDEO STUDIO — نموذج متغيّرات البيئة
# انسخ هذا الملف إلى .env ثم عدّل القيم.
# لا تُضِف هذا الملف إلى Git ولا تضع أي مفتاح داخل كود الواجهة.
# ============================================================

# ---- الخادم ----
PORT=3000
DATA_DIR=./data

# مفتاح تشفير الجلسات (٣٢ بايت على الأقل). إن لم يُحدَّد يُولَّد تلقائيًا
# ويُخزَّن في قاعدة البيانات — يُفضَّل ضبطه صراحةً في الإنتاج.
SESSION_SECRET=

# ---- حساب المالك ----
# يُهيّأ عند كل إقلاع للخادم بدور owner ووصول غير محدود. لا يمكن تسجيل هذا
# البريد من الواجهة العامة، ولا يمكن منح دور المالك من لوحة الإدارة.
# OWNER_PASSWORD: ١٠ أحرف على الأقل. إن لم تُضبط تُولَّد واحدة وتُطبَع في السجل مرة.
# في الاستضافة: أضف هذه المتغيّرات كأسرار في إعدادات البيئة ثم أعد النشر.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=

# ---- مزوّدو الذكاء الاصطناعي (نقاط تكامل مستقبلية) ----
# كل أداة تبقى «غير متصلة» حتى يُضبط المفتاح والرابط معًا.
# تُقرأ هذه القيم داخل الخادم فقط ولا تُرسَل إلى المتصفح أبدًا.
TEXT_VIDEO_API_KEY=
TEXT_VIDEO_API_URL=
IMAGE_VIDEO_API_KEY=
IMAGE_VIDEO_API_URL=
VOICE_API_KEY=
VOICE_API_URL=
CARTOON_API_KEY=
CARTOON_API_URL=

# ---- Telegram owner notifications (optional; configure in Render Environment) ----
# Create the bot with BotFather. Never commit real values.
TELEGRAM_BOT_TOKEN=
# Secret used by Telegram to authenticate webhook requests (1-256 chars; use a random value).
TELEGRAM_WEBHOOK_SECRET=
# Public private-chat ID of the owner. Set after completing the one-time pairing flow.
TELEGRAM_OWNER_CHAT_ID=
# Temporary one-time pairing secret. Remove from Render after owner chat ID is set.
TELEGRAM_PAIRING_SECRET=
# Optional; Render sets RENDER_EXTERNAL_URL automatically for web services.
PUBLIC_BASE_URL=
