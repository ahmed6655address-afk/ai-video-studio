# ============================================================
# AI VIDEO STUDIO — نموذج متغيّرات البيئة
# انسخ هذا الملف إلى .env ثم عدّل القيم.
# لا تُضِف هذا الملف إلى Git ولا تضع أي مفتاح داخل كود الواجهة.
# ============================================================

# ---- الخادم ----
PORT=3000
DATA_DIR=./data

# مفتاح تشفير الجلسات (٣٢ بايت على الأقل). إن لم يُحدَّد يُولَّد تلقائيًا
# ويُخزَّن في قاعدة البيانات — يُفضَّل ضبطه صراحةً في الإنتاج.
SESSION_SECRET=

# ---- حساب المالك ----
# يُهيّأ عند كل إقلاع للخادم بدور owner ووصول غير محدود. لا يمكن تسجيل هذا
# البريد من الواجهة العامة، ولا يمكن منح دور المالك من لوحة الإدارة.
# OWNER_PASSWORD: ١٠ أحرف على الأقل. إن لم تُضبط تُولَّد واحدة وتُطبَع في السجل مرة.
# في الاستضافة: أضف هذه المتغيّرات كأسرار في إعدادات البيئة ثم أعد النشر.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=

# رقم واتساب الدعم بصيغة دولية، أرقام فقط مع رمز الدولة (مثال: 2189XXXXXXXX).
# متغير VITE_ ظاهر للزوار في المتصفح؛ استخدم رقم دعم مخصصًا وليس رقمًا سريًا.
VITE_WHATSAPP_NUMBER=

# ---- مزوّدو الذكاء الاصطناعي (نقاط تكامل مستقبلية) ----
# كل أداة تبقى «غير متصلة» حتى يُضبط المفتاح والرابط معًا.
# تُقرأ هذه القيم داخل الخادم فقط ولا تُرسَل إلى المتصفح أبدًا.
TEXT_VIDEO_API_KEY=
TEXT_VIDEO_API_URL=
IMAGE_VIDEO_API_KEY=
IMAGE_VIDEO_API_URL=
VOICE_API_KEY=
VOICE_API_URL=
CARTOON_API_KEY=
CARTOON_API_URL=
